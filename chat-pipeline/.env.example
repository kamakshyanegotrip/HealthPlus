# --- Model provider -------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# --- Database (self-hosted Postgres, Mumbai ap-south-1 per HP-ADR-004) ----
# hp_app role only — the application must never connect as owner/superuser
# (HP-RB-001 §2). hp_app has INSERT/SELECT on response_audit_event and no
# UPDATE/DELETE/TRUNCATE grant at all (enforced again by trigger).
DATABASE_URL=postgres://hp_app:...@127.0.0.1:5432/healthplus

# --- Region / residency (HP-ADR-003, HP-ADR-004) ---------------------------
# All rows written by this service are pinned to this region. Never derive
# it from request IP or Accept-Language — resolved at auth and pinned to
# the session per Phase_1.1_Migration_Pack_ADR-003 §2.2 item 3.
DATA_REGION=IN

# --- Pseudonymisation (ADR-003 §2.3) ---------------------------------------
# HMAC key used to derive subject_pseudonym / session_pseudonym. Rotate via
# subject_key, never reuse across regions.
SUBJECT_HMAC_KEY=base64:...

# --- Auth (HP-SEC-001) ------------------------------------------------------
# HS256 shared secret used to verify Supabase-issued JWTs (src/lib/auth.ts).
# If this project moves to Supabase's asymmetric (ES256) signing keys,
# auth.ts needs a JWKS URL instead — see its header comment.
SUPABASE_JWT_SECRET=...

# --- Prompt / classifier / policy versions (HP-ESC §6.3/§6.4) --------------
# The RESPONSE CATEGORY classifier and safety-propose prompts now live in
# src/lib/prompts/registry.ts (a single swappable file — see its header
# comment for how to drop in the real "worked prompts" once they exist), so
# CATEGORY_CLASSIFIER_VERSION is no longer read from here; its version comes
# from the registry. RED_FLAG_RULESET_VERSION below is a DIFFERENT thing — it
# selects which row-set in safety.red_flag_rule (the deterministic,
# clinician-authored rules) is active, not a prompt version. Bump either only
# through the §6.3 change-control process; a bump is itself a
# safety-eval-gating event per §6.4.
RED_FLAG_RULESET_VERSION=rf-rules-2026.08.1
PROMPT_VERSION_COMPOSE=compose-2026.08.1
POLICY_VERSION=HP-SCHEMA-001-v0.4

# --- Side-effect dispatcher -------------------------------------------------
SIDE_EFFECT_DISPATCH_URL=http://localhost:4001/internal/dispatch
